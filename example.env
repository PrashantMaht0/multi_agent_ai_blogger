# ==============================================================================
# 1. LANGSMITH OBSERVABILITY & EVALUATION
# ==============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGSMITH_PROJECT="ai-blogger-multi-agent"

# ==============================================================================
# 2. LOCAL OLLAMA CONFIGURATION
# ==============================================================================
# Base URL where your local Ollama instance is serving models.
# Keep this as localhost. docker-compose.yml overrides it with host.docker.internal for
# the container; that hostname does not resolve outside Docker, so setting it here would
# break running the app directly on your machine.
OLLAMA_BASE_URL="http://localhost:11434"
EDITOR_MODEL="gemma4:12b"
WORKER_MODEL="llama3:8b"
EMBEDDING_MODEL="nomic-embed-text"

# ==============================================================================
# 3. SUPABASE & POSTGRESQL (Memory, Checkpoints & Vector Store)
# ==============================================================================
# Direct connection string for LangGraph PostgresSaver checkpointer
# (Use Session/Direct connection pooler string from Supabase Settings -> Database)
POSTGRES_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase REST/SDK API credentials for the Supabase MCP Server
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# ==============================================================================
# 4. RESEARCH TOOLS & APIS (MCP Search Server)
# ==============================================================================
# Web search provider key (e.g., Tavily API) used by the search MCP server
TAVILY_API_KEY="tvly-your_tavily_api_key_here"

# ==============================================================================
# 5. GOOGLE BLOGGER API CONFIGURATION (MCP Blogger Server)
# ==============================================================================
# The unique Blog ID found in your Blogger dashboard URL: blogger.com/blog/posts/{BLOG_ID}
BLOGGER_BLOG_ID="your_blogger_id"

# Path to your Google Cloud OAuth 2.0 client credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS="./credentials.json"

# ==============================================================================
# 6. GRADIO DASHBOARD SETTINGS
# ==============================================================================
GRADIO_SERVER_NAME="0.0.0.0"
GRADIO_SERVER_PORT=7860